# TLS 1.3, HSTS; yalnızca relay API'si ve WSS. TASLAK (çalıştırılmadı).
{$SAKLAZ_RELAY_DOMAIN} {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
	}
	request_body {
		max_size 512KB
	}
	@api path /v1/* /healthz
	handle @api {
		reverse_proxy relay:8080
	}
	handle {
		respond 404
	}
}
