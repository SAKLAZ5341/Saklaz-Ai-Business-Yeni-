# SAKLAZ AI relay — TLS sonlandırma (Sprint 3 A2).
# Gerçek alan adında sertifika ACME (Let's Encrypt) ile otomatik alınır; "localhost" verilirse Caddy
# yerel bir sertifika yetkilisi kullanır (yalnızca test). Ayrıntılar: docs/deploy/RELAY-DAGITIM-GUVENLIGI.md
{
	# ACME (Let's Encrypt) iletişim adresi için üretimde buraya "email adres@alanadi" satırı eklenir.
	# Yönetim API'si yalnızca konteynerin kendi içinden (sağlık denetimi için).
	admin 127.0.0.1:2019
	# Sertifika yetkilisini sisteme kurmaya çalışma (konteyner salt okunur ve ayrıcalıksız).
	skip_install_trust
}

{$SAKLAZ_RELAY_DOMAIN} {
	tls {
		protocols tls1.3
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 512KB
	}
	# Yalnızca relay API'si, WSS ve sağlık uçları; geri kalan her şey 404.
	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy relay:8080 {
			# İstemcinin gönderdiği X-Forwarded-For dikkate alınmaz; Caddy kendisi ekler.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle {
		respond 404
	}
	log {
		output stdout
		format json
	}
}
