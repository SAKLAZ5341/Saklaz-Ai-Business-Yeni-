    "@saklaz/testkit": "workspace:*",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.63.0",
    "tsx": "4.23.15"
  }
