{
  "name": "saklaz-ai",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "check:boundaries": "node tools/ci/check-boundaries.mjs",
    "vectors": "pnpm --filter @saklaz/protocol run vectors",
    "ci": "pnpm lint && pnpm check:boundaries && pnpm typecheck && pnpm test"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3-multiple-ciphers"]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "turbo": "2.11.11",
    "typescript": "5.8.3",
    "typescript-eslint": "8.72.2",
    "vitest": "3.2.7"
  }
}
